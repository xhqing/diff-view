{
  "name": "diff-view-vsce",
  "displayName": "diff-view-vsce",
  "description": "diff-view 的 VS Code 侧组件：按请求静默关闭由 pi 打开的 diff 标签（需配合 pi 侧组件 diff-view-pie 使用，两个都装才是完整功能）。",
  "version": "0.2.0",
  "publisher": "xhqing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xhqing/diff-view.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "find . -name '*.js' -not -path './node_modules/*' -exec node --check {} +"
  },
  "contributes": {
    "commands": [
      {
        "command": "diffViewVsce.closeAll",
        "title": "diff-view-vsce: 关闭全部由 pi 打开的 diff 标签"
      }
    ]
  }
}
