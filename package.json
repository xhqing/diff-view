{
  "name": "diff-bridge",
  "displayName": "Diff Bridge",
  "description": "pi「改动可视化」的 VSCode 侧助手：按请求静默关闭由 pi 打开的 diff 标签（配合 pi 命令 /close-diff、AI 工具 close_diff）。",
  "version": "0.1.0",
  "publisher": "xhqing",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "find . -name '*.js' -not -path './node_modules/*' -not -path './tmp/*' -exec node --check {} +"
  },
  "contributes": {
    "commands": [
      {
        "command": "diffBridge.closeAll",
        "title": "Diff Bridge: 关闭全部由 pi 打开的 diff 标签"
      }
    ]
  }
}
