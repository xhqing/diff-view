#!/usr/bin/env python3
"""diff-report — 打印上一个 pi 轮次里 AI 改了什么（turn diff）。

数据来自 diff-view 扩展：它在每轮开始时记 git 基线，轮次结束时把「本轮增量」
落盘成一份 JSON。这个脚本只读那份状态，不跑 pi、不触发任何会话，所以在任何
终端里随时可以敲。

用法：
  diff-report                 打印当前仓库上一轮的改动
  diff-report --repo <路径>    指定仓库（默认当前目录所在的 git 仓库）
  diff-report --all           列出所有仓库各自上一轮的改动摘要
  diff-report --json          输出原始 JSON（给脚本用）
  diff-report --since         不用落盘的快照，改成「上一轮基线 → 现在」重算
                              （轮次之后又改过东西时用得上）

退出码：0 = 有内容；1 = 没有可汇报的改动；2 = 用法 / 环境问题。
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# 状态目录默认跟扩展一致；测试或换机时可用环境变量指向别处。
STATE_DIR = Path(
    os.environ.get("DIFF_REPORT_STATE_DIR") or (Path.home() / ".pi" / "agent" / "state" / "cmux-diff")
)
STATE_FILE = STATE_DIR / "last-turn.json"
BASELINE_FILE = STATE_DIR / "turn-baseline.json"

KIND_MARK = {"added": "A", "deleted": "D", "renamed": "R", "modified": "M"}


def to_seconds(value) -> float | None:
    """扩展用的是 JS 的 Date.now()（毫秒），这里统一折成秒再格式化。"""
    try:
        stamp = float(value)
    except (TypeError, ValueError):
        return None
    if stamp <= 0:
        return None
    return stamp / 1000 if stamp > 1e11 else stamp


def die(message: str, code: int = 2) -> "NoReturn":  # type: ignore[name-defined]
    print(message, file=sys.stderr)
    raise SystemExit(code)


def git(cwd: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def repo_root(path: str) -> str | None:
    if not os.path.isdir(path):
        return None
    result = git(path, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        return None
    root = result.stdout.strip()
    return os.path.realpath(root) if root else None


def load_json(path: Path) -> dict:
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}


def fmt_report(report: dict, generated_at: float | None) -> str:
    files = report.get("files") or []
    name = report.get("repoName") or "?"
    title = f"本轮改动 · {len(files)} 个文件 · +{report.get('added', 0)} -{report.get('deleted', 0)} · {name}"
    lines = [title]
    width = max((len(str(item.get("path", ""))) for item in files), default=0)
    for item in files:
        mark = KIND_MARK.get(str(item.get("kind")), "M")
        stat = "二进制" if item.get("binary") else f"+{item.get('added', 0)} -{item.get('deleted', 0)}"
        lines.append(f"  {mark} {str(item.get('path', '')).ljust(width)}  {stat}")
    seconds = to_seconds(generated_at)
    if seconds:
        stamp = datetime.fromtimestamp(seconds).strftime("%Y-%m-%d %H:%M:%S")
        lines.append(f"生成于 {stamp} · {report.get('repoRoot', '')}")
    return "\n".join(lines)


def summarize(report: dict) -> str:
    files = report.get("files") or []
    return (
        f"{report.get('repoName', '?'):<28} {len(files):>3} 个文件  "
        f"+{report.get('added', 0):<5} -{report.get('deleted', 0):<5} {report.get('repoRoot', '')}"
    )


def recompute_since_baseline(root: str) -> dict | None:
    """用落盘的基线重算「基线 → 现在」；基线不存在或没有改动时返回 None。"""
    state = load_json(BASELINE_FILE).get("sessions") or {}
    candidates = [item for item in state.values() if str(item.get("repoRoot", "")) == root]
    if not candidates:
        return None
    baseline = max(candidates, key=lambda item: to_seconds(item.get("capturedAt")) or 0)
    base = baseline.get("snapshot") or baseline.get("head")
    if not base:
        return None
    numstat = git(root, "diff", "--numstat", base)
    name_status = git(root, "diff", "--name-status", base)
    if numstat.returncode != 0:
        return None
    kinds: dict[str, str] = {}
    for line in name_status.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        letter, target = parts[0], parts[-1]
        kinds[target] = {"A": "added", "D": "deleted", "R": "renamed"}.get(letter[:1], "modified")
    files, added, deleted = [], 0, 0
    for line in numstat.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        plus_raw, minus_raw, target = parts[0], parts[1], "\t".join(parts[2:])
        binary = plus_raw == "-" or minus_raw == "-"
        plus = 0 if binary else int(plus_raw or 0)
        minus = 0 if binary else int(minus_raw or 0)
        added += plus
        deleted += minus
        files.append(
            {
                "path": target,
                "added": plus,
                "deleted": minus,
                "kind": kinds.get(target, "modified"),
                "binary": binary,
            }
        )
    # 基线之后新出现的未跟踪文件按整份算新增
    status = git(root, "status", "--porcelain", "-z")
    known = set((baseline.get("untracked") or {}).keys())
    for chunk in status.stdout.split("\0"):
        if not chunk.startswith("?? "):
            continue
        target = chunk[3:]
        if target in known:
            continue
        try:
            text = (Path(root) / target).read_text(encoding="utf-8", errors="ignore")
            count = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
        except Exception:
            count = 0
        added += count
        files.append({"path": target, "added": count, "deleted": 0, "kind": "added"})
    if not files:
        return None
    files.sort(key=lambda item: item["added"] + item["deleted"], reverse=True)
    return {
        "repoName": os.path.basename(root),
        "repoRoot": root,
        "files": files,
        "added": added,
        "deleted": deleted,
        "scope": "turn",
    }


def main(argv: list[str]) -> int:
    args = list(argv[1:])
    as_json = "--json" in args
    show_all = "--all" in args
    use_baseline = "--since" in args
    repo_arg = None
    if "--repo" in args:
        index = args.index("--repo")
        if index + 1 >= len(args):
            die("--repo 需要一个路径")
        repo_arg = args[index + 1]

    state = load_json(STATE_FILE).get("repos") or {}

    if show_all:
        if not state:
            die("还没有任何仓库的轮次报告。", 1)
        if as_json:
            print(json.dumps(state, ensure_ascii=False, indent=2))
            return 0
        for report in sorted(state.values(), key=lambda item: to_seconds(item.get("generatedAt")) or 0, reverse=True):
            print(summarize(report))
        return 0

    root = repo_root(repo_arg or os.getcwd())
    if not root:
        die("这里不是 git 仓库（或用 --repo 指定一个仓库路径）。")

    if use_baseline:
        report = recompute_since_baseline(root)
        if not report:
            die("没有可汇报的改动：没有这一轮落盘的基线，或基线之后没有变化。", 1)
        print(json.dumps(report, ensure_ascii=False, indent=2) if as_json else fmt_report(report, None))
        return 0

    report = state.get(root)
    if not report:
        die("这个仓库还没有轮次报告：跑一轮带文件改动的 pi 任务后再来。", 1)
    if as_json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        print(fmt_report(report, report.get("generatedAt")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
